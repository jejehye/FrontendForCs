      <div id="right-column" class="column col-right">
        <div class="card info-card callback-info-panel">
          <div class="callback-info-tabs"><button
              class="callback-info-tab-btn is-active">콜백
              요청 이력</button>
          </div>
          <div class="callback-info-body">
            <table class="callback-history-table table-compact">
              <thead>
                <tr>
                  <th>요청일시 <i class="fa-solid fa-caret-down callback-icon-caret"></i>
                  </th>
                  <th>내용</th>
                  <th class="callback-status-col">상태</th>
                  <th>처리일시</th>
                </tr>
              </thead>
              <tbody class="callback-history-body">
                {% for row in callback_data.callback_request_histories or [] %}
                  <tr class="callback-history-row">
                    <td>{{ row.requested_at }}</td>
                    <td>{{ row.content }}</td>
                    <td{% if row.status_class == "unhandled" %} class="callback-unhandled-cell"{% endif %}><span
                        class="callback-history-badge callback-history-badge--{{ row.status_class }}">{{ row.status_text }}</span>
                    </td>
                    <td{% if row.processed_at == "-" %} class="callback-history-empty"{% endif %}>{{ row.processed_at }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
        <section id="callback-chat-area" class="info-card callback-live-chat-card">
          <header class="panel-header main-live-header">
            <h3 class="weight-semibold heading-reset">실시간 대화</h3>
            <div class="main-live-header-actions">
              <div class="main-live-search-wrap">
                <input type="text" placeholder="검색어를 입력하세요" class="field chat-search-input">
                <i class="fa-solid fa-magnifying-glass main-live-search-icon"></i>
              </div>
              <button class="main-live-pause-btn"><i class="fa-solid fa-pause"></i></button>
            </div>
          </header>
          <div class="callback-live-chat-list">
            <div class="main-live-msg main-live-msg--agent">
              <div class="main-live-msg-meta">
                <span class="main-live-time-text">14:23</span>
                <span class="main-live-agent-text">상담사 K</span>
              </div>
              <div class="chat-bubble agent">안녕하세요, 신한투자증권입니다. 무엇을 도와드릴까요?</div>
            </div>

            <div class="main-live-msg main-live-msg--customer">
              <div class="main-live-msg-meta">
                <i class="fa-regular fa-user main-live-user-icon"></i>
                <span class="main-live-customer-text">고객01</span>
              </div>
              <div class="chat-bubble customer">콜백 처리 상태와 예상 통화 가능 시간을 확인하고 싶습니다.</div>
              <div class="main-live-tag-row">
                <span class="tag-pill tag-pill--brand">콜백</span>
                <span class="tag-pill tag-pill--teal">상태확인</span>
              </div>
              <span class="main-live-time-text main-live-msg-time">14:24</span>
            </div>
          </div>
          <div class="callback-live-chat-input-wrap">
            <input type="text" class="field" placeholder="메시지를 입력하세요">
          </div>
        </section>
        <div class="card info-card callback-note-card">
          <div class="callback-section-header">
            <h3 class="callback-section-title">
              <i class="fa-solid fa-pen-to-square callback-icon-section-title"></i>
              상담 메모
            </h3>
          </div>
          <textarea
            class="callback-note-textarea"
            rows="5"
            placeholder="상담 핵심 내용을 기록하세요..."
          ></textarea>
          <div class="callback-modal-actions">
            <button class="callback-note-cancel-btn">
              <i class="fa-solid fa-rotate-left callback-icon-inline"></i>초기화
            </button>
            <button class="shinhan-gradient callback-note-submit-btn">
              <i class="fa-solid fa-save callback-icon-inline"></i>메모 저장
            </button>
          </div>
        </div>
      </div>
    </div>
