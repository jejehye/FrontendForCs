<section id="center-column" class="column col-center">
  <div class="card info-card">
    <div class="pds-card-header">
      <h3 class="pds-card-title pds-card-title--lg">
        <i class="fa-solid fa-gauge-high pds-accent-text"></i>
        다이얼링 현황
      </h3>
      <span class="pds-meta-text" id="currentTime" data-role="currentTime">2024-01-20 14:35:22</span>
    </div>

    <div class="pds-progress-wrap">
      <div class="pds-progress-inner">
        <svg class="progress-ring" viewBox="0 0 120 120">
          <circle class="progress-ring-circle" stroke="#e5e7eb" stroke-width="8" fill="transparent" r="52" cx="60" cy="60"/>
          <circle id="progressCircle" data-role="progressCircle" class="progress-ring-circle" stroke="#0046ff" stroke-width="8" fill="transparent" r="52" cx="60" cy="60" stroke-dasharray="326.73" stroke-dashoffset="326.73"/>
        </svg>
        <div class="pds-progress-center">
          <span class="pds-progress-percent" id="progressPercent" data-role="progressPercent">0%</span>
          <span class="pds-meta-text">진행률</span>
        </div>
      </div>
    </div>

    <div class="pds-metric-grid">
      <div class="pds-metric-card pds-card-muted">
        <div class="pds-metric-head">
          <i class="fa-solid fa-phone pds-accent-text"></i>
          <span class="pds-meta-text">발신 시도</span>
        </div>
        <div class="pds-metric-value pds-body-text" id="dialAttempts" data-role="dialAttempts">0</div>
      </div>
      <div class="pds-metric-card pds-card-success">
        <div class="pds-metric-head">
          <i class="fa-solid fa-check-circle pds-status-text-success"></i>
          <span class="pds-meta-text">연결 성공</span>
        </div>
        <div class="pds-metric-value pds-status-text-success" id="dialSuccess" data-role="dialSuccess">0</div>
      </div>
      <div class="pds-metric-card pds-card-danger">
        <div class="pds-metric-head">
          <i class="fa-solid fa-phone-slash pds-status-text-danger"></i>
          <span class="pds-meta-text">연결 실패</span>
        </div>
        <div class="pds-metric-value pds-status-text-danger" id="dialFailed" data-role="dialFailed">0</div>
      </div>
      <div class="pds-metric-card pds-card-muted">
        <div class="pds-metric-head">
          <i class="fa-solid fa-clock pds-accent-text"></i>
          <span class="pds-meta-text">평균 통화시간</span>
        </div>
        <div class="pds-metric-value pds-body-text" id="avgCallTime">0:00</div>
      </div>
    </div>
  </div>

  <div class="card info-card">
    <div class="pds-between-row-md">
      <h3 class="pds-card-title">
        <i class="fa-solid fa-list-check pds-accent-text"></i>
        실시간 다이얼링 로그
      </h3>
      <button class="pds-export-btn">
        <i class="fa-solid fa-download pds-icon-inline-sm"></i>내보내기
      </button>
    </div>
    <div class="pds-log-box" id="dialingLog" data-role="dialingLog">
      <div class="pds-log-line--ok">[시스템] PDS 자동다이얼링 시스템 준비완료</div>
      <div class="pds-log-line--muted">[시스템] 배정된 고객: 15명</div>
      <div class="pds-accent-text">[시스템] 다이얼링 시작 대기중...</div>
    </div>
  </div>

  <section id="pds-live-chat" class="card info-card pds-live-chat-panel" data-role="pds-live-chat">
    <header class="pds-live-chat-header main-live-header">
      <h3 class="weight-semibold heading-reset">실시간 대화</h3>
      <div class="main-live-header-actions">
        <div class="main-live-search-wrap">
          <input
            type="text"
            class="field chat-search-input"
            placeholder="검색어를 입력하세요"
            aria-label="실시간 대화 검색"
          />
          <i class="fa-solid fa-magnifying-glass main-live-search-icon"></i>
        </div>
        <button class="main-live-pause-btn" aria-label="대화 일시정지">
          <i class="fa-solid fa-pause"></i>
        </button>
      </div>
    </header>

    <div class="pds-live-chat-messages chat-message-list">
      <div class="main-live-msg main-live-msg--agent">
        <div class="main-live-msg-meta">
          <span class="main-live-time-text">14:23</span>
          <span class="main-live-agent-text">상담사 K</span>
        </div>
        <div class="chat-bubble agent main-live-bubble-elevated">
          안녕하세요, 신한투자증권입니다. 무엇을 도와드릴까요?
        </div>
      </div>

      <div class="main-live-msg main-live-msg--customer">
        <div class="main-live-msg-meta">
          <i class="fa-regular fa-user main-live-user-icon"></i>
          <span class="main-live-customer-text">고객01</span>
        </div>
        <div class="chat-bubble customer main-live-bubble-elevated">
          해외주식 ETF 관련 문의드립니다.
        </div>
        <div class="main-live-tag-row">
          <span class="tag-pill tag-pill--brand">해외주식</span>
          <span class="tag-pill tag-pill--teal">ETF</span>
        </div>
        <span class="main-live-time-text main-live-msg-time">14:24</span>
      </div>
    </div>

  </section>
</section>
