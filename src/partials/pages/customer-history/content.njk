        <div class="customer-history-top-controls__left">
          <div class="customer-history-top-row">
          <label>계좌번호</label>
          <input class="field" type="text" value="014-01004637" />
          <button class="customer-history-mini-btn" type="button">계좌</button>
          <button class="customer-history-mini-btn" type="button">비번</button>
          <i class="fa-solid fa-lock customer-history-lock-icon" aria-hidden="true"></i>

          <label>생년월일</label>
          <input class="field customer-history-small-field" type="text" value="900101" />
          <button class="customer-history-mini-btn" type="button">수신</button>
          <i class="fa-solid fa-lock customer-history-lock-icon" aria-hidden="true"></i>

          <label>고객번호</label>
