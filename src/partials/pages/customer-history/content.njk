          <div class="customer-history-info-row"><span>고객등급</span><strong>미성년</strong></div>
        </div>

        <div class="customer-history-profile__center">
          <div class="customer-history-phone-row"><span>대표번호</span><strong>1588-6600 (고객센터)</strong></div>
          <div class="customer-history-phone-row"><span>인입번호</span><strong>010-1234-5678</strong></div>
          <div class="customer-history-phone-row"><span>시장강의</span><strong>수강중</strong></div>
          <div class="customer-history-phone-row"><span>직장전화</span><strong>02-0000-0000</strong></div>
          <div class="customer-history-phone-row"><span>기타전화</span><strong>02-1234-5678</strong></div>
        </div>

        <div class="customer-history-profile__right">
          <div class="customer-history-auth-title">고객인증</div>
          <label><input type="radio" name="customer-auth" checked /> 계좌번호</label>
          <label><input type="radio" name="customer-auth" /> 계좌비밀번호</label>
          <label><input type="radio" name="customer-auth" /> 주민등록번호인증</label>
