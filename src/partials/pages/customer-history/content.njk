      <button class="warning-tab" type="button" data-action="warning-tab" data-target="campaign-history">캠페인</button>
    </div>

    <div class="customer-history-table-toolbar">
      <span class="customer-history-table-toolbar__label">조회기간</span>
      <input class="field field--history-date" type="date" value="2025-04-02" />
      <span>~</span>
