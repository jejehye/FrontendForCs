      <span class="customer-history-table-toolbar__spacer"></span>
      <span class="customer-history-table-toolbar__label">채널</span>
      <select class="field customer-history-count-select">
        <option>8선택 / 17 전체</option>
      </select>
      <button class="customer-history-icon-btn" type="button" aria-label="새로고침">
        <i class="fa-solid fa-rotate-right"></i>
      </button>
      <label class="customer-history-check-inline"><input type="checkbox" /> 이벤트</label>
      <button class="btn--history-search btn-common-action btn-common-action--search" type="button">
        <i class="fa-solid fa-magnifying-glass main-history-icon-gap"></i>조회
      </button>
    </div>

    <div class="customer-history-grid-wrap customer-history-grid-wrap--main is-active" data-target="warning-panel" data-target-value="call-history">
      <table class="tbl table--history customer-history-table">
        <thead class="main-history-thead">
          <tr>
            <th class="table__head table__head--narrow">No</th>
            <th class="table__head">상담일자</th>
            <th class="table__head">시작</th>
            <th class="table__head">종료</th>
            <th class="table__head">접수채널</th>
            <th class="table__head">인입대표</th>
            <th class="table__head">인입구분</th>
            <th class="table__head">유형(대)</th>
            <th class="table__head">유형(소)</th>
            <th class="table__head">결과</th>
            <th class="table__head">등록자</th>
            <th class="table__head">등록지점</th>
            <th class="table__head">수신번호</th>
            <th class="table__head">발신번호</th>
          </tr>
        </thead>
        <tbody class="main-history-body">
          <tr>
            <td class="tbl__cell" colspan="14">조회된 항목이 없습니다.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="customer-history-grid-wrap customer-history-grid-wrap--sub is-hidden" data-target="warning-panel" data-target-value="ars-history">
