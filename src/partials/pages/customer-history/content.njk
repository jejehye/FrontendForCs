    <div class="customer-history-grid-wrap customer-history-grid-wrap--sub is-hidden" data-target="warning-panel" data-target-value="campaign-history">
      <table class="tbl table--history customer-history-table">
        <thead class="main-history-thead">
          <tr>
            <th class="table__head table__head--narrow">No</th>
