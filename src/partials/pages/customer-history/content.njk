            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
          </div>

          <div class="customer-history-top-row customer-history-top-row--sub">
            <span class="customer-history-status-pill">운영계정</span>
            <select class="field">
              <option>한도이체입금</option>
            </select>
          </div>
        </div>

        <div class="customer-history-top-controls__right">
          <button class="btn--history-reset btn-common-action btn-common-action--reset" type="button">
            <i class="fa-solid fa-rotate-left main-history-icon-gap"></i>초기화
          </button>
          <button class="btn--history-search btn-common-action btn-common-action--search" type="button">
            <i class="fa-solid fa-magnifying-glass main-history-icon-gap"></i>조회
          </button>
        </div>
      </div>

      <div class="customer-history-profile">
