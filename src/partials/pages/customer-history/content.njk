{% set customer_history_data = page_data or {} %}

<section class="column col-chat layout-shell customer-history-main-column">
  <section class="info-card customer-history-panel">
    <header class="customer-history-panel__header">
      <span class="customer-history-panel__title">고객여정</span>
      <button type="button" class="customer-history-panel__close" aria-label="닫기">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </header>

    <div class="customer-history-top-layout">
      <div class="customer-history-top-controls">
        <div class="customer-history-top-controls__left">
          <div class="customer-history-top-row customer-history-top-row--inputs">
            <div class="customer-history-top-group">
              <label>계좌번호</label>
              <input class="field" type="text" value="{{ customer_history_data.account_number or '' }}" />
              <button class="customer-history-mini-btn" type="button">계좌</button>
              <button class="customer-history-mini-btn" type="button">비번</button>
              <i class="fa-solid fa-lock customer-history-lock-icon" aria-hidden="true"></i>
            </div>
            <div class="customer-history-top-group">
              <label>생년월일</label>
              <input class="field customer-history-small-field" type="text" value="{{ customer_history_data.birth_date or '' }}" />
              <button class="customer-history-mini-btn" type="button">수신</button>
              <i class="fa-solid fa-lock customer-history-lock-icon" aria-hidden="true"></i>
            </div>
            <div class="customer-history-top-group">
              <label>고객번호</label>
              <input class="field" type="text" value="{{ customer_history_data.customer_number or '' }}" />
              <button class="customer-history-icon-btn" type="button" aria-label="고객번호 조회">
                <i class="fa-solid fa-magnifying-glass"></i>
              </button>
            </div>
          </div>

          <div class="customer-history-top-row customer-history-top-row--sub">
            <button
              type="button"
              class="customer-history-status-pill"
              data-role="customer-history-account-status"
              data-open-label="{{ customer_history_data.account_status_label or '운영계좌' }}"
              data-closed-label="{{ customer_history_data.closed_account_status_label or '폐쇄계좌' }}"
              aria-pressed="false"
            >{{ customer_history_data.account_status_label or '운영계좌' }}</button>
            <select class="field">
              <option>{{ customer_history_data.account_type_name or '' }}</option>
            </select>
          </div>
        </div>

        <div class="customer-history-top-controls__right">
          <button class="btn--history-reset btn-common-action btn-common-action--reset" type="button">
            <i class="fa-solid fa-rotate-left main-history-icon-gap"></i>초기화
          </button>
          <button class="btn--history-search btn-common-action btn-common-action--save" type="button">
            <i class="fa-solid fa-floppy-disk main-history-icon-gap"></i>저장
          </button>
        </div>
      </div>

      <div class="customer-history-profile">
        <div class="customer-history-profile__left">
          {% for item in (customer_history_data.profile_left or []) %}
            <div class="customer-history-info-row"><span>{{ item.label }}</span><strong>{{ item.value }}</strong></div>
          {% endfor %}
        </div>

        <div class="customer-history-profile__center">
          {% for item in (customer_history_data.profile_center or []) %}
            <div class="customer-history-phone-row"><span>{{ item.label }}</span><strong>{{ item.value }}</strong></div>
          {% endfor %}
        </div>

        <div class="customer-history-profile__right">
          <div class="customer-history-auth-title">고객인증</div>
          {% for item in (customer_history_data.auth_info or []) %}
            <div class="customer-history-auth-row"><span>{{ item.label }}</span><strong>{{ item.value }}</strong></div>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="customer-history-shortcuts">
      {% for shortcut in (customer_history_data.shortcuts or []) %}
        <button class="customer-history-shortcut" type="button">{{ shortcut }}</button>
      {% endfor %}
    </div>
  </section>

  <section class="info-card customer-history-panel customer-history-panel--table">
    <div class="customer-history-tabs">
      <button class="warning-tab is-active" type="button" data-action="warning-tab" data-target="call-history">통화이력</button>
      <button class="warning-tab" type="button" data-action="warning-tab" data-target="ars-history">ARS내역</button>
      <button class="warning-tab" type="button" data-action="warning-tab" data-target="campaign-history">캠페인</button>
    </div>

    <div class="customer-history-table-toolbar">
      <div class="customer-history-table-toolbar__left">
        <span class="customer-history-table-toolbar__label">조회기간</span>
        <input class="field field--history-date" type="date" value="{{ customer_history_data.date_from or '2025-04-02' }}" />
        <span>~</span>
        <input class="field field--history-date" type="date" value="{{ customer_history_data.date_to or '2025-07-02' }}" />
        <button class="customer-history-mini-btn" type="button">당일</button>
        <button class="customer-history-mini-btn" type="button">주간</button>
        <button class="customer-history-mini-btn" type="button">월간</button>
      </div>
      <div class="customer-history-table-toolbar__right">
        <span class="customer-history-table-toolbar__label">채널</span>
        <select class="field customer-history-count-select">
          <option>{{ customer_history_data.channel_summary or '8선택 / 17 전체' }}</option>
        </select>
        <button class="customer-history-icon-btn" type="button" aria-label="새로고침">
          <i class="fa-solid fa-rotate-right"></i>
        </button>
        <label class="customer-history-check-inline"><input type="checkbox" /> 이벤트</label>
        <button class="btn--history-search btn-common-action btn-common-action--search" type="button">
            <i class="fa-solid fa-magnifying-glass main-history-icon-gap"></i>조회
          </button>
      </div>
    </div>

    <div class="customer-history-grid-wrap customer-history-grid-wrap--main is-active" data-target="warning-panel" data-target-value="call-history">
      <table class="tbl table--history customer-history-table">
        <thead class="main-history-thead">
          <tr>
            <th class="table__head table__head--narrow">No</th>
            <th class="table__head">상담일자</th>
            <th class="table__head">시작</th>
            <th class="table__head">종료</th>
            <th class="table__head">접수채널</th>
            <th class="table__head">인입대표</th>
            <th class="table__head">인입구분</th>
            <th class="table__head">유형(대)</th>
            <th class="table__head">유형(소)</th>
            <th class="table__head">결과</th>
            <th class="table__head">등록자</th>
            <th class="table__head">등록지점</th>
            <th class="table__head">수신번호</th>
            <th class="table__head">발신번호</th>
          </tr>
        </thead>
        <tbody class="main-history-body">
          {% if (customer_history_data.call_history or []) | length > 0 %}
            {% for row in (customer_history_data.call_history or []) %}
              <tr class="tbl__row">
                <td class="tbl__cell">{{ row.no }}</td>
                <td class="tbl__cell">{{ row.date }}</td>
                <td class="tbl__cell">{{ row.start }}</td>
                <td class="tbl__cell">{{ row.end }}</td>
                <td class="tbl__cell">{{ row.channel }}</td>
                <td class="tbl__cell">{{ row.inbound_main }}</td>
                <td class="tbl__cell">{{ row.inbound_type }}</td>
                <td class="tbl__cell">{{ row.type_large }}</td>
                <td class="tbl__cell">{{ row.type_small }}</td>
                <td class="tbl__cell">{{ row.result }}</td>
                <td class="tbl__cell">{{ row.registrant }}</td>
                <td class="tbl__cell">{{ row.branch }}</td>
                <td class="tbl__cell">{{ row.received_number }}</td>
                <td class="tbl__cell">{{ row.sent_number }}</td>
              </tr>
            {% endfor %}
          {% else %}
            <tr>
              <td class="tbl__cell" colspan="14">조회된 항목이 없습니다.</td>
            </tr>
          {% endif %}
        </tbody>
      </table>
    </div>

    <div class="customer-history-grid-wrap customer-history-grid-wrap--sub is-hidden" data-target="warning-panel" data-target-value="ars-history">
      <table class="tbl table--history customer-history-table">
        <thead class="main-history-thead">
          <tr>
            <th class="table__head table__head--narrow">No</th>
            <th class="table__head">일시</th>
            <th class="table__head">ARS 단계</th>
            <th class="table__head">입력값</th>
            <th class="table__head">결과</th>
          </tr>
        </thead>
        <tbody class="main-history-body">
          {% if (customer_history_data.ars_history or []) | length > 0 %}
            {% for row in (customer_history_data.ars_history or []) %}
              <tr class="tbl__row">
                <td class="tbl__cell">{{ row.no }}</td>
                <td class="tbl__cell">{{ row.datetime }}</td>
                <td class="tbl__cell">{{ row.step }}</td>
                <td class="tbl__cell">{{ row.input_value }}</td>
                <td class="tbl__cell">{{ row.result }}</td>
              </tr>
            {% endfor %}
          {% else %}
            <tr>
              <td class="tbl__cell" colspan="5">ARS 내역이 없습니다.</td>
            </tr>
          {% endif %}
        </tbody>
      </table>
    </div>

    <div class="customer-history-grid-wrap customer-history-grid-wrap--sub is-hidden" data-target="warning-panel" data-target-value="campaign-history">
      <table class="tbl table--history customer-history-table">
        <thead class="main-history-thead">
          <tr>
            <th class="table__head table__head--narrow">No</th>
            <th class="table__head">일시</th>
            <th class="table__head">캠페인명</th>
            <th class="table__head">상태</th>
            <th class="table__head">비고</th>
          </tr>
        </thead>
        <tbody class="main-history-body">
          {% if (customer_history_data.campaign_history or []) | length > 0 %}
            {% for row in (customer_history_data.campaign_history or []) %}
              <tr class="tbl__row">
                <td class="tbl__cell">{{ row.no }}</td>
                <td class="tbl__cell">{{ row.datetime }}</td>
                <td class="tbl__cell">{{ row.campaign_name }}</td>
                <td class="tbl__cell">{{ row.status }}</td>
                <td class="tbl__cell">{{ row.note }}</td>
              </tr>
            {% endfor %}
          {% else %}
            <tr>
              <td class="tbl__cell" colspan="5">캠페인 내역이 없습니다.</td>
            </tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  </section>
</section>

<section class="column col-center layout-shell customer-history-empty-center"></section>

<section class="column col-right layout-aside">
  <section class="info-card customer-history-side-card">
    <header class="main-section-header customer-history-side-header">
      <h3 class="heading-reset">인입정보</h3>
    </header>
    <div class="panel__body customer-history-side-body">
      {% for item in (customer_history_data.inbound_info or []) %}
        <div>
          <span>{{ item.label }}</span>
          <strong>{{ item.value }}</strong>
        </div>
      {% endfor %}
    </div>
  </section>

  <section class="info-card customer-history-side-card">
    <header class="main-section-header customer-history-side-header customer-history-side-header--sub">
      <h3 class="heading-reset">최근고객</h3>
      <button class="warning-tab" type="button">{{ customer_history_data.recent_customers_tab_label or 'TOP10' }}</button>
    </header>
    <div class="panel__body customer-history-recent-wrap">
      <table class="tbl table--history customer-history-recent-table">
        <thead class="main-history-thead">
          <tr>
            <th class="table__head table__head--narrow">고정</th>
            <th class="table__head">계좌번호</th>
            <th class="table__head">고객명</th>
            <th class="table__head">구분</th>
          </tr>
        </thead>
        <tbody class="main-history-body">
          {% if (customer_history_data.recent_customers or []) | length > 0 %}
            {% for row in (customer_history_data.recent_customers or []) %}
              <tr class="tbl__row">
                <td class="tbl__cell">
                  <input type="checkbox" {% if row.fixed %}checked{% endif %} />
                </td>
                <td class="tbl__cell">{{ row.account_number }}</td>
                <td class="tbl__cell">{{ row.customer_name }}</td>
                <td class="tbl__cell">{{ row.category }}</td>
              </tr>
            {% endfor %}
          {% else %}
            <tr>
              <td class="tbl__cell" colspan="4">최근고객 데이터가 없습니다.</td>
            </tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  </section>
</section>
