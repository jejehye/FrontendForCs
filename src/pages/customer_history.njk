{% extends "layouts/app-shell.njk" %}
{% set title = "이력" %}
{% set page_css = "main.css" %}
{% set active_page = "customer_history" %}

{% block app_content %}
  {% include "partials/pages/customer-history/content.njk" %}
{% endblock %}

{% block scripts %}
  <script src="{{ asset('javascript/common/ui.js') }}"></script>
  <script src="{{ asset('javascript/main/tabs.js') }}"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.body.classList.add('customer-history-mode');
      if (window.AppUi?.initSidebarNavigation) {
        window.AppUi.initSidebarNavigation({ itemSelector: '[data-role="nav-item"]' });
      }
      if (window.MainPageTabs?.init) {
        window.MainPageTabs.init();
      }
      const accountStatusButton = document.querySelector('[data-role="customer-history-account-status"]');
      if (accountStatusButton) {
        accountStatusButton.addEventListener('click', () => {
          const openLabel = accountStatusButton.dataset.openLabel || '운영계좌';
          const closedLabel = accountStatusButton.dataset.closedLabel || '폐쇄계좌';
          const isClosed = accountStatusButton.textContent.trim() === closedLabel;
          accountStatusButton.textContent = isClosed ? openLabel : closedLabel;
          accountStatusButton.setAttribute('aria-pressed', String(!isClosed));
        });
      }
    });
  </script>
{% endblock %}
